# ==============================================================================
# Car Worth - Production Environment Configuration Template
# ==============================================================================

# Server & Runtime
ENVIRONMENT=production
PORT=8000
WEB_CONCURRENCY=4

# Database (PostgreSQL Connection String & Pool Settings)
DATABASE_URL=postgresql://caruser:<SET_IN_SECRET_MANAGER>@localhost:5432/cardb
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_TIMEOUT_SECONDS=15

# Redis (Caching & Rate Limiting)
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_TTL_SECONDS=86400

# Rate Limiting Configuration
GLOBAL_RATE_LIMIT=100
AUTH_RATE_LIMIT=15
PREDICTION_RATE_LIMIT=60

# Security & Sessions
JWT_SECRET=<SET_IN_SECRET_MANAGER_64_CHAR_HEX>
SESSION_EXPIRY_DAYS=7
COOKIE_SECURE=true

# Seed Administrator Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<SET_IN_SECRET_MANAGER>
ADMIN_NAME="System Administrator"

# SMTP / Email (support ticket notifications)
# Use a Gmail App Password — NOT your regular Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=<SET_IN_SECRET_MANAGER>
SMTP_FROM=Car Worth <your_email@example.com>
SUPPORT_EMAIL=support@example.com

# Load Testing & Benchmarking Credentials
LOAD_TEST_EMAIL=loadtest@example.com
LOAD_TEST_PASSWORD=<SET_IN_SECRET_MANAGER>
