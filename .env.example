# ==============================================================================
# Car Worth - Production Environment Configuration Template
# Populate values securely from Secret Manager or environment variables.
# ==============================================================================

# Server & Runtime
ENVIRONMENT=production
PORT=8000
WEB_CONCURRENCY=4

# Database (PostgreSQL Connection String & Pool Settings)
DATABASE_URL=
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_TIMEOUT_SECONDS=15

# Redis (Caching & Rate Limiting)
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_TTL_SECONDS=86400

# Rate Limiting Configuration
GLOBAL_RATE_LIMIT=100
AUTH_RATE_LIMIT=15
PREDICTION_RATE_LIMIT=60

# Security & Sessions (JWT_SECRET must be at least 32 characters, 64-char hex recommended)
JWT_SECRET=
SESSION_EXPIRY_DAYS=7
COOKIE_SECURE=true

# Seed Administrator Credentials (required on initial startup when ENVIRONMENT=production)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="System Administrator"

# SMTP / Email (support ticket notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SUPPORT_EMAIL=

# Load Testing & Benchmarking Credentials
LOAD_TEST_EMAIL=
LOAD_TEST_PASSWORD=
